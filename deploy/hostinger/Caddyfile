{$AIECC_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Prometheus scrape endpoint stays internal
	respond /metrics 404

	# nginx (frontend container) serves the SPA and proxies /api, /docs, /ready and the WebSocket to the API
	reverse_proxy frontend:80
}
