# Copy to /opt/aiecc/.env.production on the VPS (deploy.sh generates it with random secrets for you).
# NEVER commit the real file.

# --- public address ---------------------------------------------------------------------------
AIECC_DOMAIN=aiecc.groundwire.tech
ACME_EMAIL=you@groundwire.tech            # Let's Encrypt expiry notices
AIECC_CORS_ORIGINS=https://aiecc.groundwire.tech

# --- mode -------------------------------------------------------------------------------------
# staging    = public DEMO: seeds the demo org/users (with YOUR password below)
# production = real use: no demo data (create the first admin with `make`/seed tooling)
AIECC_ENV=staging
AIECC_SEED_DEMO_DATA=true
AIECC_DEMO_PASSWORD=change-me-strong-Demo-Password-1

# --- secrets (deploy.sh generates these) ------------------------------------------------------
POSTGRES_PASSWORD=change-me-hex
AIECC_JWT_SECRET=change-me-at-least-48-random-chars
AIECC_ENCRYPTION_KEY=change-me-fernet-key
GRAFANA_ADMIN_PASSWORD=change-me

# --- models (optional; the mock provider works without any key) ------------------------------
AIECC_GEMINI_API_KEY=
AIECC_OPENAI_API_KEY=
AIECC_ANTHROPIC_API_KEY=
AIECC_NVIDIA_NIM_API_KEY=

# --- runtime ----------------------------------------------------------------------------------
AIECC_OTEL_ENABLED=false                  # true only with `--profile full`
AIECC_RATE_LIMIT_PER_MINUTE=600
