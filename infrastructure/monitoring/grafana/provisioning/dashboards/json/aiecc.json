{
  "title": "AIECC Overview",
  "uid": "aiecc-overview",
  "schemaVersion": 39,
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "10s",
  "panels": [
    {"type": "timeseries", "title": "API latency p50/p95/p99 (organic)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum(rate(aiecc_http_request_duration_seconds_bucket{synthetic=\"false\"}[1m])) by (le))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.95, sum(rate(aiecc_http_request_duration_seconds_bucket{synthetic=\"false\"}[1m])) by (le))", "legendFormat": "p95"},
       {"expr": "histogram_quantile(0.99, sum(rate(aiecc_http_request_duration_seconds_bucket{synthetic=\"false\"}[1m])) by (le))", "legendFormat": "p99"}],
     "fieldConfig": {"defaults": {"unit": "s"}}},
    {"type": "timeseries", "title": "Requests/s by synthetic flag", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(aiecc_http_request_duration_seconds_count[1m])) by (synthetic)", "legendFormat": "synthetic={{synthetic}}"}]},
    {"type": "timeseries", "title": "LLM / tool / agent p95", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "histogram_quantile(0.95, sum(rate(aiecc_operation_duration_seconds_bucket[5m])) by (le, kind))", "legendFormat": "{{kind}}"}],
     "fieldConfig": {"defaults": {"unit": "s"}}},
    {"type": "timeseries", "title": "Tokens/s & cost", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "targets": [{"expr": "sum(rate(aiecc_llm_tokens_total[5m])) by (provider)", "legendFormat": "{{provider}} tokens/s"},
                 {"expr": "sum(increase(aiecc_llm_cost_usd_total[1h]))", "legendFormat": "cost USD / h"}]},
    {"type": "stat", "title": "In-flight executions", "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4}, "targets": [{"expr": "aiecc_executions_inflight"}]},
    {"type": "stat", "title": "Queue depth", "gridPos": {"x": 6, "y": 16, "w": 6, "h": 4}, "targets": [{"expr": "aiecc_execution_queue_depth"}]},
    {"type": "stat", "title": "Retries (5m)", "gridPos": {"x": 12, "y": 16, "w": 6, "h": 4}, "targets": [{"expr": "sum(increase(aiecc_retries_total[5m]))"}]},
    {"type": "stat", "title": "Errors (5m)", "gridPos": {"x": 18, "y": 16, "w": 6, "h": 4}, "targets": [{"expr": "sum(increase(aiecc_errors_total[5m]))"}]}
  ]
}
