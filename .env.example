# ---- AIECC configuration (all variables are prefixed AIECC_) -------------------------------
# Copy to backend/.env for local runs. NEVER commit real secrets.
AIECC_ENV=local
AIECC_DATABASE_URL=postgresql+asyncpg://aiecc:aiecc@localhost:5442/aiecc
AIECC_REDIS_URL=redis://localhost:6390/0
AIECC_JOBS_MODE=inline            # inline | arq (arq requires `make worker`)

# Security — generate real values for anything beyond local dev:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIECC_JWT_SECRET=dev-only-change-me-dev-only-change-me-0123456789
AIECC_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
AIECC_ACCESS_TOKEN_TTL_S=900
AIECC_REFRESH_TOKEN_TTL_S=604800
# OIDC integration-ready (see docs/security/authentication.md)
# AIECC_OIDC_ISSUER_URL=https://login.example.com
# AIECC_OIDC_CLIENT_ID=aiecc

# Demo data (local/test only). Seeded users share this DEMO password:
AIECC_SEED_DEMO_DATA=true
AIECC_DEMO_PASSWORD=Aiecc!Demo2026

# ---- Model providers (all optional — the platform runs fully on the mock provider) ----------
AIECC_DEFAULT_PROVIDER=mock
AIECC_DEFAULT_MODEL=mock-reasoner-1
AIECC_OLLAMA_BASE_URL=http://localhost:11434
# Embeddings: mock (hash embeddings) | ollama (nomic-embed-text, 768d) | openai (text-embedding-3-small @768d)
AIECC_EMBEDDING_PROVIDER=mock
AIECC_EMBEDDING_MODEL=hash-embed-768
AIECC_EMBEDDING_DIM=768
# AIECC_OPENAI_API_KEY=
# AIECC_ANTHROPIC_API_KEY=
# AIECC_GEMINI_API_KEY=
# AIECC_NVIDIA_NIM_API_KEY=

# ---- Limits / resilience --------------------------------------------------------------------
AIECC_MAX_AGENT_STEPS_HARD_LIMIT=25
AIECC_MAX_CONCURRENT_EXECUTIONS=16
AIECC_MAX_QUEUED_EXECUTIONS=64
AIECC_TOOL_TIMEOUT_S=30
AIECC_RATE_LIMIT_PER_MINUTE=600
AIECC_RATE_LIMIT_AUTH_PER_MINUTE=20
AIECC_HTTP_TOOL_ALLOWED_HOSTS=api.github.com,httpbin.org

# ---- Observability --------------------------------------------------------------------------
AIECC_OTEL_ENABLED=false
AIECC_OTEL_ENDPOINT=http://localhost:4318
